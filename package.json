{
  "name": "schoolmart-final-workspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "node frontend/build.js",
    "build:backend": "npm run build --prefix backend",
    "typecheck:frontend": "npx tsc -p frontend/tsconfig.app.json --noEmit",
    "lint": "npm run lint --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "npm run test --prefix backend",
    "test:frontend": "npm run test --prefix frontend",
    "test:legacy": "node tests/clean-cards-verification.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "concurrently": "^9.2.1",
    "rollup-plugin-visualizer": "^7.1.3"
  },
  "dependencies": {
    "@neon/config": "^1.14.5",
    "@neon/env": "^2.1.8"
  }
}
