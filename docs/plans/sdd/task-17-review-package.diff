+
+  it('Static /uploads requests retain cross-origin resource policy: cross-origin', async () => {
+    const res = await request(app).get('/uploads/test.png');
+
+    expect(res.headers['cross-origin-resource-policy']).toBe('cross-origin');
+  });
+});
