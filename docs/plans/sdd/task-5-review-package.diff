+          where: { id: firstSportItem.id },
+          data: { published: false },
+        });
+      }
+    }
+  }, 60000);
+
+  it('resolves item by exact slug match', async () => {
+    const labsPage = await prisma.page.findUnique({
+      where: { slug: 'labs' },
+      include: { items: true },
