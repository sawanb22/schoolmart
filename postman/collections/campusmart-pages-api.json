{
  "info": {
    "_postman_id": "c1f78e12-8924-4e2b-b673-9a3c7e4e1a05",
    "name": "CampusMart Pages & Hub API",
    "description": "Collection covering CampusMart Hybrid CMS Page endpoints: legacy read path, Hub v2 (?v=2), individual item detail endpoint (/:slug/items/:itemSlug), and legacy write adapter with optimistic locking.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Public Pages",
      "item": [
        {
          "name": "Get Page (Legacy Shape v1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pages/:idOrSlug",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pages",
                ":idOrSlug"
              ],
              "variable": [
                {
                  "key": "idOrSlug",
                  "value": "labs",
                  "description": "Page ID or URL slug (e.g. labs, sports-infra, privacy-policy)"
                }
              ]
            },
            "description": "Fetches page in legacy format. Reconstructs pageData string for structured pages from tables while preserving identical backward compatibility."
          },
          "response": []
        },
        {
          "name": "Get Hub v2 (Lightweight, No Detail - Invariant I5)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pages/:slug?v=2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pages",
                ":slug"
              ],
              "query": [
                {
                  "key": "v",
                  "value": "2",
                  "description": "API version 2 for lightweight hub response without detail blobs"
                }
              ],
              "variable": [
                {
                  "key": "slug",
                  "value": "labs",
                  "description": "Hub page slug"
                }
              ]
            },
            "description": "Fetches lightweight hub payload containing page metadata, settings, collections of ItemSummary, and categories. Invariant I5 guarantees no detail key is included anywhere."
          },
          "response": []
        },
        {
          "name": "Get Hub Item Detail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pages/:slug/items/:itemSlug",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pages",
                ":slug",
                "items",
                ":itemSlug"
              ],
              "variable": [
                {
                  "key": "slug",
                  "value": "labs",
                  "description": "Hub slug"
                },
                {
                  "key": "itemSlug",
                  "value": "composite-skill-lab",
                  "description": "Item slug, title slug fallback, or redirect source"
                }
              ]
            },
            "description": "Fetches individual item full detail within hub context or returns redirectTo instruction."
          },
          "response": []
        }
      ]
    },
