# Local development
# VITE_API_URL=http://localhost:3001/api
# VITE_MEDIA_BASE_URL=http://localhost:3001

# Production: set this to the deployed backend API URL, including /api.
VITE_API_URL=https://api.campusmart.in/api

# Production: optional base URL for media uploads (defaults to API origin if unset)
VITE_MEDIA_BASE_URL=https://api.campusmart.in
