# ==============================================================================
# CampusMart / SchoolMart Backend Environment Configuration (.env)
# Optimized for cPanel Shared Hosting (Phusion Passenger / Node.js App)
# ==============================================================================

# ── 1. Database Configuration (Required) ──────────────────────────────────────
# On cPanel, PostgreSQL databases are typically named <cpaneluser>_<dbname>.
# Localhost socket or 127.0.0.1:5432 is standard for cPanel PostgreSQL.
DATABASE_URL=postgresql://<cpuser>_<dbuser>:<password>@localhost:5432/<cpuser>_<db>?schema=public
# Direct connection for Prisma migrations; on cPanel, identical to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://<cpuser>_<dbuser>:<password>@localhost:5432/<cpuser>_<db>?schema=public

# ── 2. Server & URLs (Required in Production) ─────────────────────────────────
PORT=3001
NODE_ENV=production
# Canonical public URL of the platform (used for SEO canonicals & sitemap generation)
SITE_URL=https://schoolmart.in
# Public frontend URL (used for CORS and redirect resolution)
FRONTEND_URL=https://schoolmart.in

# ── 3. Security & Authentication (Required) ───────────────────────────────────
# In production, JWT_SECRET must be at least 32 characters long.
# Generate via: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_32_chars_long

# Initial administrator bootstrap credentials (created on first start if no admin exists)
ADMIN_INITIAL_EMAIL=admin@schoolmart.in
ADMIN_INITIAL_PASSWORD=ReplaceWithStrongPassword123!

# ── 4. CORS & Allowed Origins ─────────────────────────────────────────────────
# Comma-separated list of origins allowed to make API requests with credentials.
ALLOWED_ORIGINS=https://schoolmart.in,https://www.schoolmart.in
ADMIN_URL=https://schoolmart.in

# ── 5. Persistent File Storage (cPanel Best Practice) ─────────────────────────
# IMPORTANT: Point outside the Node application root so redeployments and zip
# extractions never overwrite uploaded media or candidate resumes.
# Ensure RESUMES_DIR is outside public_html to prevent unauthenticated direct downloads.
UPLOADS_DIR=/home/<cpanel_user>/schoolmart-data/uploads
RESUMES_DIR=/home/<cpanel_user>/schoolmart-data/resumes

# ── 6. Logging & CMS Observability ────────────────────────────────────────────
# Logging level: 'fatal', 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=info
# Path where the background worker writes sitemap.xml directly into frontend web root
SITEMAP_WRITE_PATH=/home/<cpanel_user>/public_html/sitemap.xml
# Enforce strict hybrid CMS validation on all page writes (set false for emergency rollback)
CMS_STRICT_STRUCTURED_WRITES=true

# ── 7. Email OTP Delivery (cPanel Mail / SMTP or Gmail App Password) ──────────
EMAIL_USER=notifications@schoolmart.in
EMAIL_PASS=your_email_account_password
EMAIL_FROM="SchoolMart <notifications@schoolmart.in>"

# ── 8. External Integrations (Optional) ────────────────────────────────────────
# Web app URL from Google Apps Script deployment for consultation sync
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-deployment-id/exec
GOOGLE_SHEETS_WEBHOOK_SECRET=replace_with_a_long_random_webhook_secret
